{
  "compilerOptions": {
    "module": "Preserve",
    "strict": true,
    "lib": ["es2022", "dom"],
    "baseUrl": ".",
    "paths": {
      "src/*": ["src/*"],
      "app/*": ["./*"],
      "components/*": ["src/components/*"],
      "layouts/*": ["src/layouts/*"],
      "pages/*": ["src/pages/*"],
      "assets/*": ["src/assets/*"],
      "boot/*": ["src/boot/*"],
      "stores/*": ["src/stores/*"],
      "composables/*": ["src/composables/*"],
      "mocks/*": ["src/mocks/*"]
    }
  }
}
